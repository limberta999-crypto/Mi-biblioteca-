
name: Construir Mi Biblioteca

on:
  workflow_dispatch:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Descargar repositorio
        uses: actions/checkout@v4

      - name: Preparar Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Preparar Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Extraer proyecto Android
        run: |
          mkdir -p /tmp/mi-biblioteca
          unzip -q MiBibliotecaAndroid-GitHub.zip -d /tmp/mi-biblioteca
          cp -R /tmp/mi-biblioteca/MiBibliotecaAndroid/. .

      - name: Compilar APK
        run: gradle --no-daemon :app:assembleDebug

      - name: Guardar APK
        uses: actions/upload-artifact@v4
        with:
          name: Mi-Biblioteca-APK
          path: app/build/outputs/apk/debug/app-debug.apk
